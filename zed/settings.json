{
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "colorize_brackets": true,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "confirm_quit": false,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Mocha - No Italics",
  },
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "cursor_blink": false,
  "project_panel": {
    "button": true,
    "auto_fold_dirs": false,
  },
  "terminal": {
    "blinking": "off",
    "font_size": 13,
    "cursor_shape": "bar",
    "font_family": "FiraCode Nerd Font Mono",
  },
  "soft_wrap": "none",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  // "vim": {
  //   "cursor_shape": {
