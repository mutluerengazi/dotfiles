{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "colorize_brackets": true,
  "vim": {
    "cursor_shape": {
      "normal": "block",
      "insert": "block",
      "replace": "underline",
      "visual": "block",
    },
  },
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
  "confirm_quit": false,
  "show_edit_predictions": true,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Kanagawa Wave - No Italics",
  },
  "ui_font_size": 12,
  "buffer_font_size": 12,
  "ui_font_family": "FiraCode Nerd Font",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "cursor_blink": false,
  "project_panel": {
    "dock": "right",
    "button": true,
    "auto_fold_dirs": false,
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    "blinking": "off",
    "font_size": 12,
  },
  "soft_wrap": "none",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "scrollbar": {
    "show": "never",
  },
}
