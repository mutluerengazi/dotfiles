{
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "colorize_brackets": true,
  "confirm_quit": false,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "cursor_blink": false,
  "project_panel": {
    "button": true,
    "auto_fold_dirs": false,
  },
  "terminal": {
    "blinking": "off",
    "font_size": 13,
    "cursor_shape": "block",
    "font_family": "FiraCode Nerd Font Mono",
  },
  "soft_wrap": "none",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "insert": "block",
    },
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
}
